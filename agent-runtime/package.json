{
  "name": "@repo/agent-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p .",
    "start": "node --enable-source-maps dist/server.js",
    "lint": "eslint src --ext .ts",
    "test": "vitest run",
    "test:acceptance": "tsx tests/acceptance/runner.ts",
    "smoke": "tsx --env-file=.env scripts/smoke-turn.ts",
    "postinstall": "node scripts/install-mcp-deps.cjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "1",
    "@ai-sdk/openai": "1",
    "@hono/node-server": "^1",
    "@mastra/core": "^0.10",
    "@mastra/mcp": "^0.3",
    "@openrouter/ai-sdk-provider": "^0.7.5",
    "hono": "^4",
    "langfuse": "^3",
    "zod": "^3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
