{
  "playwright": {
    "command": "npx",
    "args": ["--no-install", "@playwright/mcp", "--browser", "chromium", "--headless"],
    "env": {}
  },
  "github": {
    "command": "github-mcp-server",
    "args": ["stdio", "--toolsets=repos,issues,pull_requests"],
    "env": {
      "GITHUB_PERSONAL_ACCESS_TOKEN": "$GITHUB_PERSONAL_ACCESS_TOKEN"
    }
  }
}
