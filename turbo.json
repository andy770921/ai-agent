{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**", "out/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "@repo/edge#deploy": {
      "dependsOn": ["@repo/edge#build"],
      "cache": false
    },
    "frontend#pages-deploy": {
      "dependsOn": ["frontend#build", "shared#build"],
      "cache": false
    }
  }
}
